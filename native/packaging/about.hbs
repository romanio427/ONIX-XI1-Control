<!doctype html>
<html lang="en"><meta charset="utf-8"><title>ONIX XI1 — third-party licenses</title>
<style>body{max-width:70em;margin:3em auto;font:16px system-ui;padding:1em}pre{white-space:pre-wrap}section{margin:3em 0}</style>
<h1>ONIX DAC Control — third-party licenses</h1>
<p>Generated from the locked Rust dependency graph. Slint license condition 2(b) requires the attribution badge on the public download page, not in the About dialog.</p>
{{#each licenses}}
<section><h2>{{name}}</h2><ul>{{#each used_by}}<li>{{crate.name}} {{crate.version}}</li>{{/each}}</ul><pre>{{text}}</pre></section>
{{/each}}
</html>
